# Copy to .env locally. Never commit the real file or API keys.
PROXY_UPSTREAM=https://agentrouter.org
PROXY_UPSTREAM_API_KEY=replace-with-a-new-provider-key
PROXY_LISTEN_HOST=127.0.0.1
PROXY_AUTH_TOKEN=replace-with-a-long-random-client-token
PROXY_UPSTREAM_AUTH_SCHEME=Bearer
PROXY_UPSTREAM_TIMEOUT=300
PROXY_MAX_BODY_BYTES=20971520
PROXY_INJECT_PREAMBLE=0
